<Window x:Class="EmlViewer.AssociateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EmlViewer" Height="520" Width="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
  <DockPanel Margin="20" LastChildFill="True">
    <TextBlock DockPanel.Dock="Top" Text="EmlViewer" FontSize="22" FontWeight="SemiBold"/>
    <TextBlock DockPanel.Dock="Top" Margin="0,4,0,16" TextWrapping="Wrap"
               Text="Tiny viewer for .eml message files. Launch an .eml directly — or associate the file type below."/>

    <Border DockPanel.Dock="Top" Background="#F5F7FA" BorderBrush="#DDE3EA" BorderThickness="1" CornerRadius="4" Padding="14">
      <StackPanel>
        <TextBlock FontWeight="SemiBold" Margin="0,0,0,6" Text="Associate with .eml files"/>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Windows 10/11 does not let apps silently take over a file type. The one-time flow is: register this app, then pick it as the default from the system settings page."/>
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#444" Margin="0,0,0,10"/>
        <StackPanel Orientation="Horizontal">
          <Button x:Name="RegisterBtn" Content="1. Register app" Padding="12,6" Margin="0,0,8,0" Click="Register_Click"/>
          <Button x:Name="OpenSettingsBtn" Content="2. Open Default apps" Padding="12,6" Margin="0,0,8,0" Click="OpenSettings_Click" IsEnabled="False"/>
          <Button x:Name="UnregisterBtn" Content="Unregister" Padding="12,6" Click="Unregister_Click"/>
        </StackPanel>
        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#666" FontSize="11"
                   Text="Registration is per-user (HKCU) and reversible. After clicking Open Default apps, scroll to .eml and pick EmlViewer, or search for 'EmlViewer' in the app list."/>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Top" Margin="0,14,0,0" Background="#F5F7FA" BorderBrush="#DDE3EA" BorderThickness="1" CornerRadius="4" Padding="14">
      <StackPanel>
        <TextBlock FontWeight="SemiBold" Margin="0,0,0,6" Text="Open an .eml file now"/>
        <StackPanel Orientation="Horizontal">
          <Button Content="Browse…" Padding="12,6" Click="Browse_Click"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <Grid/>
  </DockPanel>
</Window>
